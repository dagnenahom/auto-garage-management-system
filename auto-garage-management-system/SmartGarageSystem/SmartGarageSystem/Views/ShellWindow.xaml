<Window x:Class="SmartGarageSystem.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SmartGarageSystem.ViewModels"
        xmlns:views="clr-namespace:SmartGarageSystem.Views"
        Title="Smart Garage Management System" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <!-- ============================================= -->
    <!-- RESOURCES: Map ViewModels to their Views      -->
    <!-- ============================================= -->
    <Window.Resources>
        <!--<DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>-->
        <DataTemplate DataType="{x:Type vm:UserManagementViewModel}">
            <views:UserManagementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomerManagementViewModel}">
            <views:CustomerManagementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VehiclesViewModel}">
            <views:VehicleManagementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:JobCardViewModel}">
            <views:JobCardView />
        </DataTemplate>

        <!-- Add more templates here for other pages -->
    </Window.Resources>

    <!-- ============================================= -->
    <!-- MAIN LAYOUT                                  -->
    <!-- ============================================= -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with logo and user controls -->
        <Border Grid.Row="0" Background="#1E2A39" Padding="20,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Logo -->
                    <Image Source="pack://application:,,,/Resources/Garage_Logo.png" 
                           Width="60" Height="60" Margin="0,0,15,0" Stretch="Uniform" />
                    <TextBlock Text="Nahom Garage" 
                               FontSize="28" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FullName}"  
                               Foreground="LightGray" VerticalAlignment="Center"
                               Margin="0,0,20,0"/>
                    <Button Content="Logout" Width="80" Height="35"
                            Background="#E74C3C" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Command="{Binding LogoutCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sidebar + Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar navigation -->
            <Border Grid.Column="0" Background="#2C3E50">
                <StackPanel Height="604" VerticalAlignment="Bottom">
                    <!--<Button Content="  Dashboard" Style="{StaticResource NavButton}" 
                            Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                            Visibility="{Binding CanAccessUsers, Converter={StaticResource BoolToVis}}"/>-->
                    <Button Content="  Customers" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="Customers"
                            Visibility="{Binding CanAccessCustomers, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="  Vehicles" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="Vehicles"
                            Visibility="{Binding CanAccessVehicles, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="  Inventory" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="Inventory"
                            Visibility="{Binding CanAccessInventory, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="  Job Cards" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="JobCards"
                            Visibility="{Binding CanAccessJobCards, Converter={StaticResource BoolToVis}}"/>               
                    <Button Content="  Users" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="Users"
                            Visibility="{Binding CanAccessUsers, Converter={StaticResource BoolToVis}}"/>
                    

                    <!-- Add more buttons as needed -->
                </StackPanel>
            </Border>

            <!-- Main content area -->
            <Border Grid.Column="1" Background="#ECF0F1">
                <ContentControl Content="{Binding CurrentView}" />
            </Border>
        </Grid>
    </Grid>
</Window>