<Window x:Class="SmartGarageSystem.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SmartGarageSystem.ViewModels"
        Title="Smart Garage System" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <!-- Define DataTemplates to map ViewModels to Views -->

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with logo and user controls -->
        <Border Grid.Row="0" Background="#1E2A39" Padding="20,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!--Image Source="/Resources/Garage_Logo.png" 
                           Width="60" Height="60" Margin="0,0,15,0"/-->
                    <TextBlock Text="Smart Garage System" 
                               FontSize="28" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Welcome, Nahom Dagne" 
                               Foreground="LightGray" VerticalAlignment="Center"
                               Margin="0,0,20,0"/>
                    <Button Content="Logout" Width="80" Height="35"
                            Background="#E74C3C" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Command="{Binding LogoutCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sidebar + Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar navigation -->
            <Border Grid.Column="0" Background="#2C3E50">
                <StackPanel>
                    <Button Content="  Dashboard" Style="{StaticResource NavButton}" 
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="Dashboard"/>
                    <Button Content="  Customers" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="Customers"/>
                    <Button Content="  Vehicles" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="Vehicles"/>
                    <Button Content="  Job Card" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="Inventory"/>
                    <Button Content="  Inventory" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="Inventory"/>
                    <!-- more buttons... -->
                </StackPanel>
            </Border>

            <!-- Main content area -->
            <Border Grid.Column="1" Background="#ECF0F1">
                <ContentControl Content="{Binding CurrentView}" />
            </Border>
        </Grid>
    </Grid>
</Window>