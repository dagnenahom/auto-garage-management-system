<UserControl x:Class="SmartGarageSystem.Views.StockBalanceReportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartGarageSystem.Views"
        mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Header -->
            <Grid Margin="0,0,0,15">
                <TextBlock Text="Stock Balance Report" FontSize="28" FontWeight="Bold" Foreground="#2C3E50"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" 
                        HorizontalAlignment="Right" Width="80" Height="30"/>
            </Grid>

            <!-- Total value card -->
            <Border Background="White" CornerRadius="10" Width="250" Height="90" Margin="0,0,0,20"
                    Effect="{DynamicResource CardShadow}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Report.TotalValue, StringFormat=C}" FontSize="32" FontWeight="Bold" Foreground="#27AE60" HorizontalAlignment="Center"/>
                    <TextBlock Text="Total Inventory Value" FontSize="14" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Items list -->
            <TextBlock Text="All Items" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <Border Background="White" CornerRadius="10" Padding="15" Effect="{DynamicResource CardShadow}">
                <ItemsControl ItemsSource="{Binding Report.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,5" BorderBrush="#ECF0F1" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding PartName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding PartNumber}" FontSize="12" Foreground="Gray"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding QuantityInStock, StringFormat='Qty: {0}'}" VerticalAlignment="Center" Foreground="#2980B9"/>
                                    <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat='Price: {0:C}'}" VerticalAlignment="Center" Foreground="#7F8C8D"/>
                                    <TextBlock Grid.Column="3" Text="{Binding TotalValue, StringFormat='Value: {0:C}'}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#27AE60"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Loading -->
            <TextBlock Text="Loading..." Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" 
                       FontSize="16" Foreground="Gray" HorizontalAlignment="Center" Margin="0,15,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>