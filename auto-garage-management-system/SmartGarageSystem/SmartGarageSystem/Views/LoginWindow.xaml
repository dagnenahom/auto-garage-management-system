<Window x:Class="SmartGarageSystem.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartGarageSystem.Views" xmlns:viewmodels="clr-namespace:SmartGarageSystem.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:LoginViewModel}"
        mc:Ignorable="d"
        Title="Login - Garage System" Height="566" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="'BooltoVis" />
    </Window.Resources>
    <Border Background="White" CornerRadius="15" BorderBrush="#E0E0E0"
            BorderThickness="1" Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center" Margin="40,0,40,0" Height="506">

            <!-- Close button -->
            <TextBlock Text="✕" FontSize="20"
                       Foreground="#95A5A6" Cursor="Hand"
                       MouseLeftButtonDown="CloseButton_Click"/>
            <!-- Garage Name -->
            <TextBlock Text="Nahom Garage" FontSize="24" 
                       FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="#2C3E50" Margin="0,0,0,30"/>

            <!-- Username -->
            <TextBlock Text="Username" Margin="0,0,0,5" Foreground="#7F8C8D"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Height="40" FontSize="16" Padding="10,8"
                     BorderBrush="#BDC3C7" BorderThickness="1" 
                     Background="#F9F9F9"/>

            <!-- Password -->
            <TextBlock Text="Password" Margin="0,15,0,5" Foreground="#7F8C8D"/>
            <PasswordBox x:Name="PasswordBox" Height="40" FontSize="16"
                         Padding="10,8" BorderBrush="#BDC3C7" 
                         BorderThickness="1" Background="#F9F9F9"/>

            <!-- Error message -->
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" 
                       Margin="0,10,0,0" TextWrapping="Wrap"/>

            <!-- Login button -->
            <Button Content="LOGIN" Height="45" Margin="0,30,0,10"
                    Background="#2980B9" Foreground="White" FontSize="18"
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                    Command="{Binding LoginCommand}"
                    CommandParameter="{Binding ElementName=PasswordBox}" />
            <!-- Logo -->
            <!--Image Source="/Resources/Garage_Logo.png"  Width="120" Height="120"/-->
            <Image Source="{StaticResource ResourceKey=GarageLogo}" Width="120" Height="120"/>

        </StackPanel>
    </Border>

</Window>
